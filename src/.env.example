# Copy to src/.env and fill in. Never commit src/.env.
# Generate passwords with e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Bot token from @BotFather
TELEGRAM=

# Your numeric Telegram id (ask @userinfobot). Only this user can use the bot;
# updates from anyone else are ignored without a reply. Required.
OWNER_ID=
# Only needed once, when upgrading a database from the old bot that has several users:
# your old Telegram username, so the migration knows which data is yours.
OWNER_USERNAME=

# PostgreSQL (HOST=db inside docker compose, localhost when running locally)
HOST=db
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=
PORT=5432
# Must use the same user/password/db as above
DB_URL=postgresql+asyncpg://finance:CHANGE_ME@db:5432/finance

# 1 enables debug logging
DEBUG=0

# Redis (REDIS_HOST=redis inside docker compose). Password is required by docker-compose.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery broker: same Redis, separate db number after the slash
CELERY_HOST=redis
CELERY_PORT=6379/1

# Optional: sending reports by email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# For Gmail use an app password, not your account password
SMTP_PASSWORD=

# Optional: pgAdmin (docker compose --profile tools up -d pgadmin)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
