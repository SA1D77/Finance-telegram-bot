# Copy to src/.env and fill in. Never commit src/.env.
# Generate passwords with e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Bot token from @BotFather
TELEGRAM=

# Your numeric Telegram id (ask @userinfobot). Only this user can use the bot;
# updates from anyone else are ignored without a reply. Required.
OWNER_ID=
# Only for upgrading a database made by the ORIGINAL (username-based) bot with several users:
# your Telegram username without @, e.g. SAID_777 (not your display name). Leave empty otherwise.
OWNER_USERNAME=
# Who can use the bot: public = anyone (each person sees only their own data; on the first start they pick
# a language and a currency), owner = only OWNER_ID. /backup and e-mail reports always stay owner-only.
ACCESS_MODE=public

# PostgreSQL (HOST=db inside docker compose, localhost when running locally)
HOST=db
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=
PORT=5432
# Must use the same user/password/db as above
DB_URL=postgresql+asyncpg://finance:CHANGE_ME@db:5432/finance

# 1 enables debug logging
DEBUG=0

# Redis (REDIS_HOST=redis inside docker compose). Password is required by docker-compose.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery broker: same Redis, separate db number after the slash
CELERY_HOST=redis
CELERY_PORT=6379/1

# Optional: sending reports by email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# For Gmail use an app password, not your account password
SMTP_PASSWORD=

# Optional: pgAdmin (docker compose --profile tools up -d pgadmin)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Features: 1 = on (default), 0 = off
# Quick entry: "500 кафе обед", "+50000 зарплата", "1200+350*2 продукты"
FEATURE_QUICK_INPUT=1
# History, edits and undo: /history, /undo, the "📜 История" button
FEATURE_HISTORY=1
# Monthly limits with 80% / 100% alerts (sent by the celery worker): /budget, the "🎯 Бюджет" button
FEATURE_BUDGETS=1
# Monthly analytics: /stats, the "📈 Аналитика" button
FEATURE_ANALYTICS=1
# Recurring operations created by the celery "beat" container: /recurring, the "🔁 Регулярные" button
FEATURE_RECURRING=1
# Savings goals: /goals, the "⭐ Цели" button
FEATURE_GOALS=1
# Export to CSV/XLSX: /export
FEATURE_EXPORT=1
# Daily database backup at BACKUP_HOUR (local time), last BACKUP_KEEP copies in ./backups, file sent to you in Telegram
FEATURE_BACKUP=1
BACKUP_HOUR=3
BACKUP_KEEP=7
BACKUP_TO_TELEGRAM=1
# Each user picks a main currency at the first start (and in Settings). BASE_CURRENCY is only the fallback.
# "50 usd кафе", "50$ отель" are converted by the rate of the day (free fawazahmed0 currency-api).
FEATURE_CURRENCIES=1
BASE_CURRENCY=
# Offline recognition (free, nothing leaves your computer). Off by default: turning it on makes
# start.bat build a bigger image (voice: ffmpeg + Vosk Russian model ~45 MB; receipts: Tesseract).
# Voice message "пятьсот кафе обед" -> 500 кафе обед; receipt photo -> its total. Both ask before saving.
FEATURE_VOICE=0
FEATURE_RECEIPTS=0

# Your time zone (IANA name) for dates in history and reports, e.g. Asia/Tashkent, Europe/Moscow
TIMEZONE=UTC
